{
  "name": "aegisnews-workspace",
  "private": true,
  "packageManager": "pnpm@10.33.1",
  "scripts": {
    "web:dev": "pnpm --filter @aegisnews/web dev",
    "web:lint": "pnpm --filter @aegisnews/web lint",
    "web:typecheck": "pnpm --filter @aegisnews/web typecheck",
    "web:build": "pnpm --filter @aegisnews/web build",
    "web:test": "pnpm --filter @aegisnews/web test",
    "web:api:check": "pnpm --filter @aegisnews/web api:check",
    "web:test:e2e": "pnpm --filter @aegisnews/web test:e2e"
  }
}
