local.file_match "aegis" {
  path_targets = [{"__path__" = "/var/log/aegis/*.jsonl", "service" = "aegisnews"}]
}
loki.source.file "aegis" {
  targets = local.file_match.aegis.targets
  forward_to = [loki.write.local.receiver]
}
loki.write "local" {
  endpoint { url = "http://loki:3100/loki/api/v1/push" }
}
