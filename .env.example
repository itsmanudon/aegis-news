# Local dummy credentials only. Never use these outside loopback development.
AEGIS_DATABASE_URL=postgresql+psycopg://aegis:aegis_dev_only@localhost:5432/aegisnews
AEGIS_REDIS_URL=redis://localhost:6379/0
AEGIS_S3_ENDPOINT_URL=http://localhost:9000
AEGIS_S3_ACCESS_KEY=aegis_dev
AEGIS_S3_SECRET_KEY=aegis_dev_only
AEGIS_S3_BUCKET=aegisnews
AEGIS_S3_REGION=us-east-1
# path for MinIO; virtual for Railway buckets.
AEGIS_S3_ADDRESSING_STYLE=path
AEGIS_TEMPORAL_ADDRESS=localhost:7233
AEGIS_TEMPORAL_NAMESPACE=default
AEGIS_TEMPORAL_TASK_QUEUE=aegis-foundation
AEGIS_TEMPORAL_ENABLED=false
AEGIS_OTEL_ENABLED=false
AEGIS_OTEL_ENDPOINT=http://localhost:4318/v1/traces
AEGIS_CORS_ORIGINS=["http://localhost:3000"]
AEGIS_API_INTERNAL_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Opt-in for local foundation; production requires enabled OIDC security.
AEGIS_ENVIRONMENT=development
AEGIS_SECURITY_ENABLED=false
# The API refuses to start with security off unless this is true. Local machines only;
# production refuses it.
AEGIS_ALLOW_INSECURE_LOCAL=true
AEGIS_DEV_IDENTITY_ENABLED=false
AEGIS_OIDC_ISSUER=
AEGIS_OIDC_AUDIENCE=
AEGIS_OIDC_JWKS_URL=
AEGIS_OIDC_PUBLIC_KEYS={}
AEGIS_OIDC_ALGORITHMS=["RS256"]
AEGIS_OIDC_TOKEN_TYPES=["at+jwt"]
# Longest accepted gap between a token's iat and exp, in seconds.
AEGIS_OIDC_MAX_TOKEN_LIFETIME=86400
AEGIS_SECURITY_KEY_DIRECTORY=.keys
AEGIS_SECURITY_RATE_BACKEND=memory
AEGIS_SECURITY_RATE_LIMIT=60
AEGIS_SECURITY_MAX_BODY_BYTES=262144

# Integrated AI baseline: no downloads. light/full require preinstalled local models.
AEGIS_AI_PROFILE=offline
AEGIS_PROVENANCE_KEY_ID=local
AEGIS_SECURITY_PERSIST_AUDIT=false

# Optional backend-only manual acquisition. Missing key disables only that provider.
# Requests per provider per UTC day, counted across runs. Unlisted providers have none.
AEGIS_PROVIDER_DAILY_REQUESTS={"newsdata": 200, "gnews": 100, "newsapi": 100}
AEGIS_NEWSDATA_API_KEY=
AEGIS_GNEWS_API_KEY=
AEGIS_NEWSAPI_API_KEY=
AEGIS_YOUTUBE_API_KEY=
AEGIS_PROVIDER_INGESTION_API_URL=http://127.0.0.1:8000

# Daily job (python -m aegis.jobs.daily). See docs/daily-job.md.
AEGIS_JOB_PROVIDERS=["newsdata"]
AEGIS_JOB_QUERY=stocks OR markets OR earnings
AEGIS_JOB_LIMIT=10
AEGIS_JOB_TIMEOUT_SECONDS=1200
AEGIS_TEMPORAL_CLI_PATH=temporal
# Ed25519 private key as PEM for a host with no disk. Leave empty locally. Never commit one.
AEGIS_PROVENANCE_SIGNING_KEY=
