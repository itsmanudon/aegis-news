{
  "additionalProperties": false,
  "properties": {
    "analysis_id": {
      "anyOf": [
        {
          "pattern": "^ana_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Analysis Id"
    },
    "document_id": {
      "pattern": "^doc_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Document Id",
      "type": "string"
    },
    "end_offset": {
      "exclusiveMinimum": 0,
      "title": "End Offset",
      "type": "integer"
    },
    "entity_id": {
      "anyOf": [
        {
          "pattern": "^ent_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Entity Id"
    },
    "evidence_kind": {
      "enum": [
        "fact",
        "model_output"
      ],
      "title": "Evidence Kind",
      "type": "string"
    },
    "mention_id": {
      "pattern": "^mention_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Mention Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "start_offset": {
      "minimum": 0,
      "title": "Start Offset",
      "type": "integer"
    },
    "surface": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Surface",
      "type": "string"
    }
  },
  "required": [
    "mention_id",
    "document_id",
    "surface",
    "start_offset",
    "end_offset",
    "evidence_kind"
  ],
  "title": "EntityMention",
  "type": "object"
}
