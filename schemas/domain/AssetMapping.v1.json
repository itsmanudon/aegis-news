{
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "entity_id": {
      "pattern": "^ent_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Entity Id",
      "type": "string"
    },
    "identifier": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Identifier",
      "type": "string"
    },
    "mapping_id": {
      "pattern": "^map_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Mapping Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "scheme": {
      "enum": [
        "exchange_symbol",
        "isin",
        "provider_id"
      ],
      "title": "Scheme",
      "type": "string"
    },
    "venue": {
      "anyOf": [
        {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Venue"
    }
  },
  "required": [
    "mapping_id",
    "entity_id",
    "scheme",
    "identifier",
    "created_at"
  ],
  "title": "AssetMapping",
  "type": "object"
}
