{
  "additionalProperties": false,
  "properties": {
    "analysis_id": {
      "anyOf": [
        {
          "pattern": "^ana_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Analysis Id"
    },
    "available_at": {
      "format": "date-time",
      "title": "Available At",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "document_ids": {
      "items": {
        "pattern": "^doc_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Document Ids",
      "type": "array"
    },
    "entity_ids": {
      "default": [],
      "items": {
        "pattern": "^ent_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "title": "Entity Ids",
      "type": "array"
    },
    "event_id": {
      "pattern": "^evt_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Event Id",
      "type": "string"
    },
    "evidence_kind": {
      "enum": [
        "fact",
        "model_output"
      ],
      "title": "Evidence Kind",
      "type": "string"
    },
    "occurred_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Occurred At"
    },
    "revision": {
      "default": 1,
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "summary": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "summary",
    "document_ids",
    "created_at",
    "available_at",
    "evidence_kind"
  ],
  "title": "NewsEvent",
  "type": "object"
}
