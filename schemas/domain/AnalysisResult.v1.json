{
  "$defs": {
    "EmbeddingResult": {
      "additionalProperties": false,
      "properties": {
        "result_type": {
          "const": "embedding",
          "default": "embedding",
          "title": "Result Type",
          "type": "string"
        },
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "values": {
          "items": {
            "type": "number"
          },
          "minItems": 1,
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "values"
      ],
      "title": "EmbeddingResult",
      "type": "object"
    },
    "EntityExtractionResult": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "end_offset": {
          "exclusiveMinimum": 0,
          "title": "End Offset",
          "type": "integer"
        },
        "predicted_kind": {
          "anyOf": [
            {
              "enum": [
                "organization",
                "person",
                "location",
                "other"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Predicted Kind"
        },
        "result_type": {
          "const": "entity_extraction",
          "default": "entity_extraction",
          "title": "Result Type",
          "type": "string"
        },
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "start_offset": {
          "minimum": 0,
          "title": "Start Offset",
          "type": "integer"
        },
        "surface": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Surface",
          "type": "string"
        }
      },
      "required": [
        "surface",
        "start_offset",
        "end_offset",
        "confidence"
      ],
      "title": "EntityExtractionResult",
      "type": "object"
    },
    "EntityResolutionResult": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "entity_id": {
          "anyOf": [
            {
              "pattern": "^ent_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Entity Id"
        },
        "mention_id": {
          "pattern": "^mention_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Mention Id",
          "type": "string"
        },
        "result_type": {
          "const": "entity_resolution",
          "default": "entity_resolution",
          "title": "Result Type",
          "type": "string"
        },
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "mention_id",
        "entity_id",
        "confidence"
      ],
      "title": "EntityResolutionResult",
      "type": "object"
    },
    "EventClassificationResult": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "event_id": {
          "pattern": "^evt_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Event Id",
          "type": "string"
        },
        "event_revision": {
          "minimum": 1,
          "title": "Event Revision",
          "type": "integer"
        },
        "label": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "result_type": {
          "const": "event_classification",
          "default": "event_classification",
          "title": "Result Type",
          "type": "string"
        },
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "event_id",
        "event_revision",
        "label",
        "confidence"
      ],
      "title": "EventClassificationResult",
      "type": "object"
    },
    "EventExtractionResult": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "document_id": {
          "pattern": "^doc_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Document Id",
          "type": "string"
        },
        "evidence_text": {
          "minLength": 1,
          "title": "Evidence Text",
          "type": "string"
        },
        "occurred_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Occurred At"
        },
        "proposed_event_type": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Proposed Event Type",
          "type": "string"
        },
        "result_type": {
          "const": "event_extraction",
          "default": "event_extraction",
          "title": "Result Type",
          "type": "string"
        },
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "proposed_event_type",
        "confidence",
        "document_id",
        "evidence_text"
      ],
      "title": "EventExtractionResult",
      "type": "object"
    },
    "SentimentResult": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "entity_id": {
          "anyOf": [
            {
              "pattern": "^ent_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entity Id"
        },
        "label": {
          "enum": [
            "positive",
            "neutral",
            "negative",
            "mixed"
          ],
          "title": "Label",
          "type": "string"
        },
        "result_type": {
          "const": "sentiment",
          "default": "sentiment",
          "title": "Result Type",
          "type": "string"
        },
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "score": {
          "maximum": 1,
          "minimum": -1,
          "title": "Score",
          "type": "number"
        }
      },
      "required": [
        "label",
        "score",
        "confidence"
      ],
      "title": "SentimentResult",
      "type": "object"
    },
    "TopicResult": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "label": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "result_type": {
          "const": "topic",
          "default": "topic",
          "title": "Result Type",
          "type": "string"
        },
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "label",
        "confidence"
      ],
      "title": "TopicResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "analysis_id": {
      "pattern": "^ana_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Analysis Id",
      "type": "string"
    },
    "analysis_type": {
      "enum": [
        "topic",
        "sentiment",
        "entity_extraction",
        "entity_resolution",
        "embedding",
        "event_extraction",
        "event_classification"
      ],
      "title": "Analysis Type",
      "type": "string"
    },
    "available_at": {
      "format": "date-time",
      "title": "Available At",
      "type": "string"
    },
    "configuration_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Configuration Hash",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "document_id": {
      "pattern": "^doc_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Document Id",
      "type": "string"
    },
    "model_name": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Model Name",
      "type": "string"
    },
    "model_version": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Model Version",
      "type": "string"
    },
    "outputs": {
      "items": {
        "discriminator": {
          "mapping": {
            "embedding": "#/$defs/EmbeddingResult",
            "entity_extraction": "#/$defs/EntityExtractionResult",
            "entity_resolution": "#/$defs/EntityResolutionResult",
            "event_classification": "#/$defs/EventClassificationResult",
            "event_extraction": "#/$defs/EventExtractionResult",
            "sentiment": "#/$defs/SentimentResult",
            "topic": "#/$defs/TopicResult"
          },
          "propertyName": "result_type"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/TopicResult"
          },
          {
            "$ref": "#/$defs/SentimentResult"
          },
          {
            "$ref": "#/$defs/EntityExtractionResult"
          },
          {
            "$ref": "#/$defs/EntityResolutionResult"
          },
          {
            "$ref": "#/$defs/EmbeddingResult"
          },
          {
            "$ref": "#/$defs/EventExtractionResult"
          },
          {
            "$ref": "#/$defs/EventClassificationResult"
          }
        ]
      },
      "title": "Outputs",
      "type": "array"
    },
    "provider": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Provider",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "analysis_id",
    "document_id",
    "analysis_type",
    "provider",
    "model_name",
    "model_version",
    "configuration_hash",
    "created_at",
    "available_at",
    "outputs"
  ],
  "title": "AnalysisResult",
  "type": "object"
}
